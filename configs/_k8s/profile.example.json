{
  "_note": "k8s 通道 profiling 矩阵模板（复制为 configs/_k8s/profile.json，gitignored）。容器内工具取决于镜像：默认仅启用 spdiag；perf/runqlat/offcputime 需镜像内已安装。sudo 字段在 k8s 下无意义（pod 内即 root）。nodes=auto 表示本配置涉及的 pod。",
  "nodes": "auto",
  "trigger": "whole_run",
  "tools": {
    "spdiag": {
      "enabled": true
    },
    "perf": {
      "enabled": false,
      "freq": 99,
      "callgraph": "fp",
      "output": "perf.data"
    },
    "runqlat": {
      "enabled": false,
      "interval_s": 10
    },
    "offcputime": {
      "enabled": false,
      "min_block_us": 1000
    },
    "mem": {
      "enabled": true,
      "interval_s": 1,
      "proc_pattern": "mooncake_benchmark_client",
      "leak_growth_pct": 30,
      "leak_min_mb": 200
    },
    "urma": {
      "enabled": false,
      "bin": "mdcli",
      "slot": 2,
      "ubpus": [0, 1],
      "interval_s": 1,
      "bytes_per_flit": 20
    }
  },
  "outliers": {
    "threshold_ms": 1.0,
    "window_ms": 200,
    "auto": true
  }
}
